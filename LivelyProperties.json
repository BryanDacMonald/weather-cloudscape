{
  "lblWeather": {
    "type": "label",
    "value": "Live weather"
  },
  "liveWeather": {
    "type": "checkbox",
    "value": true,
    "text": "Use live local weather"
  },
  "location": {
    "type": "textbox",
    "value": "",
    "text": "Location (city, or lat,lon; blank = detect from IP)"
  },
  "refresh": {
    "type": "button",
    "value": "Refresh now",
    "text": "Weather"
  },
  "manualCover": {
    "type": "slider",
    "value": 40,
    "min": 0,
    "max": 100,
    "step": 1,
    "text": "Cloud cover % (when live weather is off)"
  },
  "viewBearing": {
    "type": "slider",
    "value": 180,
    "min": 0,
    "max": 359,
    "step": 1,
    "text": "Compass direction the view faces (180 = south)"
  },
  "motion": {
    "type": "slider",
    "value": 12,
    "min": 1,
    "max": 60,
    "step": 1,
    "text": "Cloud motion speed (x real time)"
  },
  "precip": {
    "type": "checkbox",
    "value": true,
    "text": "Rain, snow and lightning"
  },
  "showWx": {
    "type": "checkbox",
    "value": true,
    "text": "Show weather readout"
  },
  "units": {
    "type": "dropdown",
    "value": 0,
    "text": "Units",
    "items": [
      "°C",
      "°F"
    ]
  },
  "lblBg": {
    "type": "label",
    "value": "Background"
  },
  "bgMode": {
    "type": "dropdown",
    "value": 0,
    "text": "Background",
    "items": [
      "Procedural landscape",
      "Image"
    ]
  },
  "bgImage": {
    "type": "folderDropdown",
    "value": "sample-valley.png",
    "text": "Image (add files with the + button, or put them in the wallpaper's images folder)",
    "filter": "*.png|*.jpg|*.jpeg|*.webp|*.bmp",
    "folder": "images"
  },
  "maskMode": {
    "type": "dropdown",
    "value": 0,
    "text": "Sky mask",
    "items": [
      "Auto (detect sky)",
      "Image transparency",
      "Horizon line"
    ]
  },
  "horizonAuto": {
    "type": "checkbox",
    "value": true,
    "text": "Auto horizon (from the mask)"
  },
  "horizon": {
    "type": "slider",
    "value": 0.62,
    "min": 0.05,
    "max": 0.98,
    "step": 0.005,
    "text": "Horizon line (fraction down the screen)"
  },
  "feather": {
    "type": "slider",
    "value": 0.3,
    "min": 0,
    "max": 1,
    "step": 0.01,
    "text": "Mask edge softness"
  },
  "imgFov": {
    "type": "slider",
    "value": 55,
    "min": 20,
    "max": 100,
    "step": 1,
    "text": "Sky field of view (match your photo's lens)"
  },
  "relight": {
    "type": "slider",
    "value": 0.85,
    "min": 0,
    "max": 1,
    "step": 0.01,
    "text": "Relight image with time of day & cloud"
  },
  "lblSky": {
    "type": "label",
    "value": "Night sky"
  },
  "realSky": {
    "type": "checkbox",
    "value": true,
    "text": "Real stars, Moon & planets for your location (needs live weather)"
  },
  "planets": {
    "type": "checkbox",
    "value": true,
    "text": "Show planets"
  },
  "skyDark": {
    "type": "dropdown",
    "value": 1,
    "text": "Sky darkness (how many stars you see)",
    "items": [
      "City",
      "Suburban",
      "Rural",
      "Dark site"
    ]
  },
  "starBright": {
    "type": "slider",
    "value": 1,
    "min": 0,
    "max": 3,
    "step": 0.05,
    "text": "Star brightness"
  },
  "moonScale": {
    "type": "slider",
    "value": 1,
    "min": 1,
    "max": 4,
    "step": 0.1,
    "text": "Moon size (1 = real size)"
  },
  "lblPerf": {
    "type": "label",
    "value": "Performance"
  },
  "quality": {
    "type": "dropdown",
    "value": 1,
    "text": "Quality",
    "items": [
      "Low",
      "Medium",
      "High",
      "Ultra"
    ]
  },
  "fpsCap": {
    "type": "dropdown",
    "value": 3,
    "text": "Frame cap",
    "items": [
      "10",
      "15",
      "20",
      "30",
      "60"
    ]
  },
  "showPanel": {
    "type": "checkbox",
    "value": false,
    "text": "Show advanced in-page panel (all renderer settings)"
  }
}
