{
  "lblWeather": {
    "type": "label",
    "value": "Live weather"
  },
  "liveWeather": {
    "type": "checkbox",
    "value": true,
    "text": "Use live local weather"
  },
  "location": {
    "type": "textbox",
    "value": "",
    "text": "Location: exact coordinates like 44.9778, -93.2650 work best (right-click your home in Google Maps); or a city / ZIP; blank = from IP"
  },
  "refresh": {
    "type": "button",
    "value": "Refresh now",
    "text": "Weather"
  },
  "manualCover": {
    "type": "slider",
    "value": 40,
    "min": 0,
    "max": 100,
    "step": 1,
    "text": "Cloud cover % (when live weather is off)"
  },
  "viewBearing": {
    "type": "slider",
    "value": 180,
    "min": 0,
    "max": 359,
    "step": 1,
    "text": "Compass direction the view faces (180 = south)"
  },
  "motion": {
    "type": "slider",
    "value": 12,
    "min": 1,
    "max": 60,
    "step": 1,
    "text": "Cloud motion speed (x real time)"
  },
  "precip": {
    "type": "checkbox",
    "value": true,
    "text": "Rain, snow and lightning"
  },
  "glass": {
    "type": "checkbox",
    "value": true,
    "text": "Window glass: raindrops, condensation and frost"
  },
  "glassAmt": {
    "type": "slider",
    "value": 1,
    "min": 0,
    "max": 1.5,
    "step": 0.05,
    "text": "Glass effect strength"
  },
  "groundFx": {
    "type": "checkbox",
    "value": true,
    "text": "Snow cover, wet ground and ground fog"
  },
  "showWx": {
    "type": "checkbox",
    "value": true,
    "text": "Show weather readout"
  },
  "units": {
    "type": "dropdown",
    "value": 0,
    "text": "Units",
    "items": [
      "°C",
      "°F"
    ]
  },
  "lblBg": {
    "type": "label",
    "value": "Background"
  },
  "bgMode": {
    "type": "dropdown",
    "value": 0,
    "text": "Background",
    "items": [
      "Procedural landscape",
      "Image"
    ]
  },
  "bgImage": {
    "type": "folderDropdown",
    "value": "sample-valley.png",
    "text": "Image (add files with the + button, or put them in the wallpaper's images folder)",
    "filter": "*.png|*.jpg|*.jpeg|*.webp|*.bmp",
    "folder": "images"
  },
  "maskMode": {
    "type": "dropdown",
    "value": 0,
    "text": "Sky mask",
    "items": [
      "Auto (detect sky)",
      "Image transparency",
      "Horizon line"
    ]
  },
  "horizonAuto": {
    "type": "checkbox",
    "value": true,
    "text": "Auto horizon (from the mask)"
  },
  "horizon": {
    "type": "slider",
    "value": 0.62,
    "min": 0.05,
    "max": 0.98,
    "step": 0.005,
    "text": "Horizon line (fraction down the screen)"
  },
  "feather": {
    "type": "slider",
    "value": 0.1,
    "min": 0,
    "max": 1,
    "step": 0.01,
    "text": "Extra edge softening (usually leave low)"
  },
  "imgFov": {
    "type": "slider",
    "value": 55,
    "min": 20,
    "max": 100,
    "step": 1,
    "text": "Sky field of view (match your photo's lens)"
  },
  "relight": {
    "type": "slider",
    "value": 0.85,
    "min": 0,
    "max": 1,
    "step": 0.01,
    "text": "Relight image with time of day & cloud"
  },
  "windSway": {
    "type": "slider",
    "value": 1,
    "min": 0,
    "max": 3,
    "step": 0.05,
    "text": "Wind sway of trees and grass (0 = off)"
  },
  "swayMask": {
    "type": "textbox",
    "value": "",
    "text": "Motion mask file in the images folder (blank = automatic), e.g. meadow-motion-mask.png"
  },
  "birds": {
    "type": "checkbox",
    "value": true,
    "text": "Birds (by season, time of day and weather; migrating geese spring and fall)"
  },
  "birdAmt": {
    "type": "slider",
    "value": 1,
    "min": 0,
    "max": 3,
    "step": 0.05,
    "text": "Bird activity"
  },
  "traffic": {
    "type": "slider",
    "value": 1,
    "min": 0,
    "max": 4,
    "step": 0.05,
    "text": "Traffic (1 = typical quiet street; 0 = off)"
  },
  "roadsMask": {
    "type": "textbox",
    "value": "",
    "text": "Roads mask file in the images folder (red = road you can see, blue = road hidden behind something)"
  },
  "viewHeight": {
    "type": "slider",
    "value": 16,
    "min": 1.5,
    "max": 80,
    "step": 0.5,
    "text": "Viewpoint height in metres (sizes the cars; raise it if cars look too big)"
  },
  "nightLights": {
    "type": "checkbox",
    "value": true,
    "text": "Night lights in windows and lamps"
  },
  "lightsMask": {
    "type": "textbox",
    "value": "",
    "text": "Lights mask file in the images folder (blank = automatic: lights on detected houses)"
  },
  "lightsBright": {
    "type": "slider",
    "value": 1,
    "min": 0,
    "max": 2,
    "step": 0.05,
    "text": "Night light brightness"
  },
  "lightsSize": {
    "type": "slider",
    "value": 1,
    "min": 0.5,
    "max": 3,
    "step": 0.05,
    "text": "Night light size"
  },
  "lblSky": {
    "type": "label",
    "value": "Night sky"
  },
  "realSky": {
    "type": "checkbox",
    "value": true,
    "text": "Real stars, Moon & planets for your location (needs live weather)"
  },
  "planets": {
    "type": "checkbox",
    "value": true,
    "text": "Show planets"
  },
  "skyDark": {
    "type": "dropdown",
    "value": 1,
    "text": "Sky darkness (how many stars you see)",
    "items": [
      "City",
      "Suburban",
      "Rural",
      "Dark site"
    ]
  },
  "starBright": {
    "type": "slider",
    "value": 1,
    "min": 0,
    "max": 3,
    "step": 0.05,
    "text": "Star brightness"
  },
  "aurora": {
    "type": "checkbox",
    "value": true,
    "text": "Northern lights (live NOAA geomagnetic activity)"
  },
  "auroraBright": {
    "type": "slider",
    "value": 1,
    "min": 0,
    "max": 3,
    "step": 0.05,
    "text": "Aurora brightness"
  },
  "iss": {
    "type": "checkbox",
    "value": true,
    "text": "ISS passes (real orbit)"
  },
  "meteors": {
    "type": "checkbox",
    "value": true,
    "text": "Meteors (real shower dates and radiants)"
  },
  "moonScale": {
    "type": "slider",
    "value": 1,
    "min": 1,
    "max": 4,
    "step": 0.1,
    "text": "Moon size (1 = real size)"
  },
  "lblAir": {
    "type": "label",
    "value": "Air traffic"
  },
  "flights": {
    "type": "checkbox",
    "value": true,
    "text": "Real-time aircraft (ADS-B data from adsb.lol)"
  },
  "flightPoll": {
    "type": "dropdown",
    "value": 1,
    "text": "Aircraft update interval (seconds; longer = less data)",
    "items": [
      "10",
      "30",
      "60"
    ]
  },
  "contrails": {
    "type": "checkbox",
    "value": true,
    "text": "Contrails (when the upper air is cold and humid enough)"
  },
  "planeSize": {
    "type": "slider",
    "value": 2,
    "min": 1,
    "max": 6,
    "step": 0.1,
    "text": "Aircraft size (1 = real size)"
  },
  "planeLabels": {
    "type": "checkbox",
    "value": false,
    "text": "Flight labels (callsign, type, altitude)"
  },
  "lblWin": {
    "type": "label",
    "value": "Window"
  },
  "parallax": {
    "type": "slider",
    "value": 0.6,
    "min": 0,
    "max": 2,
    "step": 0.05,
    "text": "Parallax: the view shifts as your mouse moves, like moving your head at a window (0 = off)"
  },
  "sound": {
    "type": "checkbox",
    "value": false,
    "text": "Ambient sound: rain, wind, thunder, dawn birds, summer crickets (synthesised from the live weather)"
  },
  "soundVol": {
    "type": "slider",
    "value": 0.5,
    "min": 0,
    "max": 1,
    "step": 0.01,
    "text": "Sound volume"
  },
  "lblPerf": {
    "type": "label",
    "value": "Performance"
  },
  "quality": {
    "type": "dropdown",
    "value": 1,
    "text": "Quality",
    "items": [
      "Low",
      "Medium",
      "High",
      "Ultra"
    ]
  },
  "fpsCap": {
    "type": "dropdown",
    "value": 3,
    "text": "Frame cap",
    "items": [
      "10",
      "15",
      "20",
      "30",
      "60"
    ]
  },
  "gpuBudget": {
    "type": "slider",
    "value": 15,
    "min": 3,
    "max": 60,
    "step": 1,
    "text": "GPU budget (% of graphics card time the clouds may use; lower = lighter, slightly softer clouds)"
  },
  "showPanel": {
    "type": "checkbox",
    "value": false,
    "text": "Show advanced in-page panel (all renderer settings)"
  },
  "showStatus": {
    "type": "checkbox",
    "value": false,
    "text": "Status panel: shows whether each feature is working and what it is doing"
  },
  "keepSettings": {
    "type": "checkbox",
    "value": true,
    "text": "Keep my settings when reinstalling (this panel may show defaults; your saved settings are used)"
  },
  "checkUpdates": {
    "type": "checkbox",
    "value": true,
    "text": "Check GitHub for a newer version once a day"
  }
}
